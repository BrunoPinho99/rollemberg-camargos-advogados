# ==============================================================================
# INTEGRAÇÃO GOOGLE CALENDAR + GOOGLE MEET (100% NATIVA)
# Copie este arquivo para .env.local e preencha os valores abaixo.
# ==============================================================================

# 1. No Google Cloud Console (https://console.cloud.google.com/):
#    - Ative a "Google Calendar API"
#    - Em "Credenciais" -> "Criar Credenciais" -> "ID do cliente OAuth" (Aplicativo da Web)
#    - Adicione em URIs de redirecionamento autorizados:
#      http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 2. Com o servidor rodando (npm run dev), acesse no navegador:
#    http://localhost:3000/api/google/auth
#    Autorize com a conta Google do escritório e copie o token gerado abaixo:
GOOGLE_REFRESH_TOKEN=""

# ID da agenda (deixe "primary" para usar a agenda principal da conta)
GOOGLE_CALENDAR_ID="primary"

# (Opcional) Webhook para receber os leads capturados no Passo 1 e agendamentos (n8n, Make, Zapier, CRM)
LEAD_WEBHOOK_URL=""

